# 复制成 .env 再填真实值：cp .env.example .env
# .env 不入库（.gitignore 已排除）。用法：set -a; source .env; set +a
# 文档和归档的 report.json 里出现的 $RWKV_API 等占位符，都指这里的变量。

# 推理服务（rwkv_lightning_cuda，/v1/batch/completions、/v1/adapters）
RWKV_API=http://127.0.0.1:8100
# e5 Flat 检索服务（/retrieve）
RETRIEVER_URL=http://127.0.0.1:8002
# e5 重排检索服务（BM25 top50 → e5 重排）
RERANK_URL=http://127.0.0.1:8001
# 在线 RL 训练服务端（rwkv_miss_tune_server）
TUNE_SERVER=http://127.0.0.1:8848
# 训练服务端可执行文件（服务器上的路径，scripts/probe.sh 用）
TUNE_BIN=
# 词表（scripts/fake_rl_server.py 用）
RWKV_VOCAB=rwkv_vocab_v20230424.txt

# RL 训练和评测用的服务器（ssh 目标的主机部分），以及第一轮 SFT / RL 用的训练机
TRAIN_HOST=
SFT_HOST=

# 蒸馏用的教师接口（OpenAI 兼容）
API_BASE=
API_KEY=
